# Modelo do EnvironmentFile da aplicacao.
# O deploy.sh instala este arquivo em /etc/ufla-shop.env.example e, na primeira
# execucao, copia dele o /etc/ufla-shop.env trocando TROCAR_SENHA por uma senha
# aleatoria. O arquivo com a senha de verdade nunca entra no git.

DATABASE_URL=postgresql://loja:TROCAR_SENHA@localhost:5432/loja
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=30
